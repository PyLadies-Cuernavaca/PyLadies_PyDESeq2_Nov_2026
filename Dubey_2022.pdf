      <dc:title>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">An E3 Ubiquitin Ligase Scaffolding Protein Is Proviral during Chikungunya Virus Infection in Aedes aegypti</rdf:li>
        </rdf:Alt>
      </dc:title>
      <dc:identifier>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">10.1128/spectrum.00595-22</rdf:li>
        </rdf:Alt>
